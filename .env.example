# ALQA business WhatsApp number including country code, digits only.
# Leave empty until the actual number is supplied. Never use an invented number.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public site address with https and no trailing slash, e.g. https://www.example.qa
# Used for canonical links, sitemap.xml, robots.txt, Open Graph and LocalBusiness schema. Rebuild after changing.
NEXT_PUBLIC_SITE_URL=

# Where "Start a project" form submissions are POSTed as JSON (Make, Zapier, Formspree, Slack, CRM webhook...).
# Server-only; never exposed to the browser. When empty, the form tells visitors it is being connected.
ENQUIRY_WEBHOOK_URL=
